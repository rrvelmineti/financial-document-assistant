# Copy to .env (never commit .env) or set these in your shell.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional: semantic search with Gemini embeddings (default when a key is set) or offline hashing
# EMBEDDER=gemini
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional: PostgreSQL instead of the local SQLite file (see docker-compose.yml)
# DATABASE_URL=postgresql+psycopg://fda:fda@localhost:5432/fda
